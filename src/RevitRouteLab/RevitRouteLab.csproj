<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' != '2024'">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RevitRouteLab</AssemblyName>
    <RootNamespace>RevitRouteLab</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RevitApiPath Condition="'$(RevitApiPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitApiPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitApiPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitApiPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <None Update="Modules\AutoTrayRouting\Config\AutoTrayRouting.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>AutoTrayRouting.default.json</TargetPath>
    </None>
  </ItemGroup>
  <Target Name="CheckRevitVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RevitVersion)' != '2024' and '$(RevitVersion)' != '2025'" Text="Supported Revit versions: 2024, 2025. Revit 2026 requires migrating ElementId.IntegerValue usages." />
    <Error Condition="!Exists('$(RevitApiPath)\RevitAPI.dll')" Text="Revit API missing. Install Revit $(RevitVersion) or set RevitApiPath." />
  </Target>
</Project>
